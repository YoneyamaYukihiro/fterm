<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fterm.UI.ViewModels"
        xmlns:ctl="using:Fterm.UI.Controls"
        xmlns:v="using:Fterm.UI.Views"
        xmlns:loc="using:Fterm.Core.Localization"
        x:Class="Fterm.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="fterm" Width="1100" Height="720">

    <Window.Styles>
        <Style Selector="TextBox.terminal">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,Monospace" />
            <Setter Property="Background" Value="#1e1e1e" />
            <Setter Property="Foreground" Value="#dcdcdc" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="EchoTabTemplate" x:DataType="vm:TabItemViewModel">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="4">
                    <TextBox Grid.Column="0" Text="{Binding Input}" Watermark="入力して Enter" />
                    <Button Grid.Column="1" Content="送信" Margin="4,0,0,0" Command="{Binding SendCommand}" />
                </Grid>
                <TextBox Classes="terminal" IsReadOnly="True" Text="{Binding Output}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="TerminalTabTemplate" x:DataType="vm:TerminalTabViewModel">
            <Grid>
                <ctl:TerminalControl x:Name="Terminal" Emulator="{Binding Emulator}"
                                     SearchHits="{Binding SearchHits}"
                                     UserInput="OnTerminalUserInput"
                                     UserResize="OnTerminalUserResize" />
                <Border IsVisible="{Binding SearchVisible}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,12,0" Padding="6"
                        Background="#2d2d2d" BorderBrush="#555" BorderThickness="1" CornerRadius="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Width="200" Text="{Binding SearchText}" Watermark="検索 (Esc で閉じる)" KeyDown="OnSearchKeyDown" />
                        <TextBlock Text="{Binding SearchStatus}" Foreground="#bbb" VerticalAlignment="Center" />
                        <Button Content="×" Command="{Binding HideSearchCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileTabTemplate" x:DataType="vm:FileTabViewModel">
            <v:FileTabContent />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding [menu.file], Source={x:Static loc:Localizer.Instance}}">
                <MenuItem Header="{Binding [menu.file.newConnection], Source={x:Static loc:Localizer.Instance}}" InputGesture="Ctrl+N" Command="{Binding NewConnectionCommand}" />
                <MenuItem Header="{Binding [menu.file.quickConnection], Source={x:Static loc:Localizer.Instance}}" InputGesture="Ctrl+Shift+N" />
                <Separator />
                <MenuItem Header="{Binding [menu.file.connect], Source={x:Static loc:Localizer.Instance}}" Command="{Binding ConnectCommand}" InputGesture="Ctrl+Enter" />
                <MenuItem Header="{Binding [menu.file.openEchoTab], Source={x:Static loc:Localizer.Instance}}" Command="{Binding NewEchoTabCommand}" />
                <Separator />
                <MenuItem Header="{Binding [menu.file.exit], Source={x:Static loc:Localizer.Instance}}" />
            </MenuItem>
            <MenuItem Header="{Binding [menu.edit], Source={x:Static loc:Localizer.Instance}}">
                <MenuItem Header="{Binding [menu.edit.copy], Source={x:Static loc:Localizer.Instance}}" InputGesture="Ctrl+C" />
                <MenuItem Header="{Binding [menu.edit.paste], Source={x:Static loc:Localizer.Instance}}" InputGesture="Ctrl+V" />
                <MenuItem Header="{Binding [menu.edit.find], Source={x:Static loc:Localizer.Instance}}" InputGesture="Ctrl+F" Click="OnFindMenuClicked" />
            </MenuItem>
            <MenuItem Header="{Binding [menu.view], Source={x:Static loc:Localizer.Instance}}">
                <MenuItem Header="{Binding [menu.view.sidePanel], Source={x:Static loc:Localizer.Instance}}" InputGesture="F9" />
            </MenuItem>
            <MenuItem Header="{Binding [menu.connection], Source={x:Static loc:Localizer.Instance}}">
                <MenuItem Header="{Binding [menu.connection.new], Source={x:Static loc:Localizer.Instance}}" Command="{Binding NewConnectionCommand}" />
                <MenuItem Header="{Binding [menu.connection.edit], Source={x:Static loc:Localizer.Instance}}" Command="{Binding EditConnectionCommand}" />
                <MenuItem Header="{Binding [menu.connection.duplicate], Source={x:Static loc:Localizer.Instance}}" Command="{Binding DuplicateConnectionCommand}" />
                <MenuItem Header="{Binding [menu.connection.delete], Source={x:Static loc:Localizer.Instance}}" Command="{Binding DeleteConnectionCommand}" />
                <Separator />
                <MenuItem Header="{Binding [menu.file.connect], Source={x:Static loc:Localizer.Instance}}" Command="{Binding ConnectCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding [menu.transfer], Source={x:Static loc:Localizer.Instance}}">
                <MenuItem Header="{Binding [menu.transfer.openSftp], Source={x:Static loc:Localizer.Instance}}" Command="{Binding OpenSftpCommand}" />
                <MenuItem Header="{Binding [menu.transfer.openQueue], Source={x:Static loc:Localizer.Instance}}" InputGesture="Ctrl+J" />
            </MenuItem>
            <MenuItem Header="{Binding [menu.settings], Source={x:Static loc:Localizer.Instance}}">
                <MenuItem Header="{Binding [menu.settings.preferences], Source={x:Static loc:Localizer.Instance}}" InputGesture="Ctrl+," Click="OnPreferencesClicked" />
            </MenuItem>
            <MenuItem Header="{Binding [menu.help], Source={x:Static loc:Localizer.Instance}}">
                <MenuItem Header="{Binding [menu.help.about], Source={x:Static loc:Localizer.Instance}}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="接続" Command="{Binding ConnectCommand}" />
                <Separator Width="1" Background="#555" Margin="4,0" />
                <Button Content="新規接続" Command="{Binding NewConnectionCommand}" />
                <Button Content="編集" Command="{Binding EditConnectionCommand}" />
                <Button Content="複製" Command="{Binding DuplicateConnectionCommand}" />
                <Button Content="削除" Command="{Binding DeleteConnectionCommand}" />
                <Separator Width="1" Background="#555" Margin="4,0" />
                <Button Content="SFTP" Command="{Binding OpenSftpCommand}" />
                <Button Content="マクロ" IsEnabled="False" />
                <Button Content="設定" IsEnabled="False" />
                <Separator Width="1" Background="#555" Margin="4,0" />
                <Button Content="エコータブ" Command="{Binding NewEchoTabCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid ColumnDefinitions="240,4,*">
            <Border Grid.Column="0" Background="#252526" BorderBrush="#333" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="接続帳" Foreground="#bbb" Margin="8" />
                    <ListBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" DoubleTapped="OnConnectionDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Border Background="#3c5a78" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding Protocol}" FontSize="10" Foreground="#dde" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Foreground="#888" FontSize="11">
                                        <Run Text="{Binding Username}" />
                                        <Run Text="@" />
                                        <Run Text="{Binding Host}" />
                                        <Run Text=":" />
                                        <Run Text="{Binding Port}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="#333" />

            <TabControl Grid.Column="2" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.DataTemplates>
                    <DataTemplate x:DataType="vm:TabItemViewModel">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EchoTabTemplate}" />
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:TerminalTabViewModel">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TerminalTabTemplate}" />
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:FileTabViewModel">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FileTabTemplate}" />
                    </DataTemplate>
                </TabControl.DataTemplates>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
